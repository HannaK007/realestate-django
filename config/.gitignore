# Python compiled files
*.pyc
*.pyo
*.pyd
__pycache__/

# Virtual environments
venv/
env/
ENV/

# Django database (use SQLite locally, ignore in GitHub)
db.sqlite3

# Django static files (collected for production)
staticfiles/

# Media files (property images, uploads)
media/

# Django migrations (optional: include if you want clean repo)
*/migrations/*.py
!*/migrations/__init__.py

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Mac system files
.DS_Store

# Logs
*.log

# Pytest cache
.pytest_cache/

# Environment variables
.env